# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# La "publishable key" (sb_publishable_...) o, en proyectos viejos, la "anon key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Poné 1 cuando Google esté activado en Supabase (Authentication → Sign In / Providers).
NEXT_PUBLIC_GOOGLE_LOGIN=0
